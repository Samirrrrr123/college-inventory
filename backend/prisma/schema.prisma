generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Role {
  id    String @id @default(uuid()) @db.Uuid
  code  String @unique
  users User[]
}

model User {
  id           String          @id @default(uuid()) @db.Uuid
  name         String
  email        String          @unique
  passwordHash String
  isBlocked    Boolean         @default(false)
  roleId       String          @db.Uuid
  role         Role            @relation(fields: [roleId], references: [id])
  createdAt    DateTime        @default(now())
  sessions     Session[]
  resetTokens  PasswordReset[]
  activity     AuditEntry[]
  movements    Movement[]
  requests     EquipmentRequest[] @relation("Requester")
  reviews      EquipmentRequest[] @relation("Reviewer")
  borrowed     Loan[] @relation("Recipient")
  issuedLoans  Loan[] @relation("Issuer")
  returnedLoans Loan[] @relation("Returner")
  attachments Attachment[]
  startedChecks InventoryCheck[] @relation("CheckCreator")
  completedChecks InventoryCheck[] @relation("CheckCompleter")

  @@index([roleId])
  @@index([name])
}

model Session {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @db.Uuid
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshHash String   @unique
  expiresAt   DateTime
  createdAt   DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model PasswordReset {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime

  @@index([userId])
}

model AuditEntry {
  id        String   @id @default(uuid()) @db.Uuid
  actorId   String   @db.Uuid
  actor     User     @relation(fields: [actorId], references: [id])
  action    String
  entityType String?
  entityId   String? @db.Uuid
  details    Json?
  createdAt DateTime @default(now())

  @@index([actorId, createdAt])
  @@index([createdAt, id])
  @@index([entityType, entityId, createdAt])
  @@index([action, createdAt])
}

enum EquipmentStatus {
  available
  issued
  repair
  written_off
}

model Category {
  id        String      @id @default(uuid()) @db.Uuid
  name      String      @unique @db.VarChar(100)
  equipment Equipment[]
}

model Room {
  id          String      @id @default(uuid()) @db.Uuid
  number      String      @db.VarChar(30)
  name        String      @db.VarChar(100)
  building    String      @db.VarChar(100)
  floor       Int
  equipment   Equipment[]
  movementsIn Movement[]  @relation("MovementToRoom")
  movementsOut Movement[] @relation("MovementFromRoom")
  inventoryChecks InventoryCheck[]

  @@unique([building, number])
  @@index([number])
}

model Equipment {
  id              String          @id @default(uuid()) @db.Uuid
  name            String          @db.VarChar(200)
  inventoryNumber String          @unique @db.VarChar(80)
  serialNumber    String?         @db.VarChar(100)
  description     String          @default("") @db.VarChar(5000)
  status          EquipmentStatus @default(available)
  categoryId      String          @db.Uuid
  roomId          String          @db.Uuid
  category        Category        @relation(fields: [categoryId], references: [id], onDelete: NoAction)
  room            Room            @relation(fields: [roomId], references: [id], onDelete: NoAction)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  movements       Movement[]
  requestItems    RequestItem[]
  loanItems       LoanItem[]
  attachments     Attachment[]
  inventoryItems  InventoryItem[]

  @@index([categoryId])
  @@index([roomId])
  @@index([status, createdAt, id])
  @@index([name, id])
}

model Movement {
  id          String    @id @default(uuid()) @db.Uuid
  equipmentId String    @db.Uuid
  fromRoomId  String    @db.Uuid
  toRoomId    String    @db.Uuid
  actorId     String    @db.Uuid
  reason      String    @db.VarChar(1000)
  createdAt   DateTime  @default(now())
  equipment   Equipment @relation(fields: [equipmentId], references: [id], onDelete: NoAction)
  fromRoom    Room      @relation("MovementFromRoom", fields: [fromRoomId], references: [id], onDelete: NoAction)
  toRoom      Room      @relation("MovementToRoom", fields: [toRoomId], references: [id], onDelete: NoAction)
  actor       User      @relation(fields: [actorId], references: [id], onDelete: NoAction)

  @@index([equipmentId, createdAt])
  @@index([createdAt, id])
  @@index([fromRoomId])
  @@index([toRoomId])
  @@index([actorId])
}

enum RequestStatus {
  pending
  approved
  rejected
  cancelled
}

model EquipmentRequest {
  id           String @id @default(uuid()) @db.Uuid
  number       Int @unique @default(autoincrement())
  requesterId  String @db.Uuid
  reviewerId   String? @db.Uuid
  purpose      String @db.VarChar(300)
  status       RequestStatus @default(pending)
  decisionNote String @default("") @db.VarChar(500)
  createdAt    DateTime @default(now())
  reviewedAt   DateTime?
  requester    User @relation("Requester", fields: [requesterId], references: [id], onDelete: NoAction)
  reviewer     User? @relation("Reviewer", fields: [reviewerId], references: [id], onDelete: NoAction)
  items        RequestItem[]
  loan         Loan?

  @@index([requesterId, createdAt])
  @@index([status, createdAt])
}

model RequestItem {
  requestId   String @db.Uuid
  equipmentId String @db.Uuid
  request     EquipmentRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  equipment   Equipment @relation(fields: [equipmentId], references: [id], onDelete: NoAction)

  @@id([requestId, equipmentId])
  @@index([equipmentId])
}

model Loan {
  id           String @id @default(uuid()) @db.Uuid
  number       Int @unique @default(autoincrement())
  requestId    String? @unique @db.Uuid
  recipientId  String @db.Uuid
  issuedById   String @db.Uuid
  returnedById String? @db.Uuid
  issuedAt     DateTime @default(now())
  dueAt        DateTime
  returnedAt   DateTime?
  request      EquipmentRequest? @relation(fields: [requestId], references: [id], onDelete: NoAction)
  recipient    User @relation("Recipient", fields: [recipientId], references: [id], onDelete: NoAction)
  issuedBy     User @relation("Issuer", fields: [issuedById], references: [id], onDelete: NoAction)
  returnedBy   User? @relation("Returner", fields: [returnedById], references: [id], onDelete: NoAction)
  items        LoanItem[]

  @@index([recipientId, issuedAt])
  @@index([returnedAt, dueAt])
  @@index([issuedById])
  @@index([returnedById])
}

model LoanItem {
  loanId      String @db.Uuid
  equipmentId String @db.Uuid
  loan        Loan @relation(fields: [loanId], references: [id], onDelete: Cascade)
  equipment   Equipment @relation(fields: [equipmentId], references: [id], onDelete: NoAction)

  @@id([loanId, equipmentId])
  @@index([equipmentId])
}

model Attachment {
  id           String @id @default(uuid()) @db.Uuid
  equipmentId  String @db.Uuid
  uploadedById String @db.Uuid
  name         String @db.VarChar(160)
  contentType  String @db.VarChar(40)
  size         Int
  content      Bytes
  createdAt    DateTime @default(now())
  equipment    Equipment @relation(fields: [equipmentId], references: [id], onDelete: NoAction)
  uploadedBy   User @relation(fields: [uploadedById], references: [id], onDelete: NoAction)

  @@index([equipmentId, createdAt])
  @@index([uploadedById])
}

model InventoryCheck {
  id            String @id @default(uuid()) @db.Uuid
  number        Int @unique @default(autoincrement())
  roomId        String @db.Uuid
  createdById   String @db.Uuid
  completedById String? @db.Uuid
  createdAt     DateTime @default(now())
  completedAt   DateTime?
  room          Room @relation(fields: [roomId], references: [id], onDelete: NoAction)
  createdBy     User @relation("CheckCreator", fields: [createdById], references: [id], onDelete: NoAction)
  completedBy   User? @relation("CheckCompleter", fields: [completedById], references: [id], onDelete: NoAction)
  items         InventoryItem[]

  @@index([roomId, createdAt])
  @@index([createdById])
  @@index([completedById])
  @@index([completedAt])
}

model InventoryItem {
  checkId         String @db.Uuid
  equipmentId     String @db.Uuid
  equipmentName   String @db.VarChar(200)
  inventoryNumber String @db.VarChar(80)
  statusAtStart   EquipmentStatus
  found           Boolean?
  checkedAt       DateTime?
  check           InventoryCheck @relation(fields: [checkId], references: [id], onDelete: Cascade)
  equipment       Equipment @relation(fields: [equipmentId], references: [id], onDelete: NoAction)

  @@id([checkId, equipmentId])
  @@index([equipmentId])
  @@index([checkId, found])
}
